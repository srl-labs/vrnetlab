instance-id: vce1
local-hostname: vce1

# GE1 (management, container eth0) keeps its factory address 192.168.2.1/24.
# network-interfaces: dict keyed by interface name (GE3, GE4, ...)
#   GE3:
#     type: static          # or dhcp
#     ipaddr: 11.32.33.1
#     netmask: 255.255.255.0
#     gateway: 11.32.33.254 # optional
network-interfaces:
  GE3:                      # container eth2 -> router eth4
    type: static
    ipaddr: 172.25.0.2
    netmask: 255.255.255.0
    gateway: 172.25.0.1
  GE4:                      # container eth3 -> router eth3
    type: static
    ipaddr: 100.64.66.2
    netmask: 255.255.255.0
    gateway: 100.64.66.1
